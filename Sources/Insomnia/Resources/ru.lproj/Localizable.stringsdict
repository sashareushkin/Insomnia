<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>minutes</key><dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
        <key>count</key><dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>d</string>
            <key>one</key><string>%d минута</string>
            <key>few</key><string>%d минуты</string>
            <key>many</key><string>%d минут</string>
            <key>other</key><string>%d минуты</string>
        </dict>
    </dict>
    <key>hours</key><dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
        <key>count</key><dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>d</string>
            <key>one</key><string>%d час</string>
            <key>few</key><string>%d часа</string>
            <key>many</key><string>%d часов</string>
            <key>other</key><string>%d часа</string>
        </dict>
    </dict>
    <key>days</key><dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
        <key>count</key><dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>d</string>
            <key>one</key><string>%d день</string>
            <key>few</key><string>%d дня</string>
            <key>many</key><string>%d дней</string>
            <key>other</key><string>%d дня</string>
        </dict>
    </dict>
    <key>appsFrozen</key><dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
        <key>count</key><dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>d</string>
            <key>one</key><string>%d приложение остановлено</string>
            <key>few</key><string>%d приложения остановлены</string>
            <key>many</key><string>%d приложений остановлено</string>
            <key>other</key><string>%d приложения остановлены</string>
        </dict>
    </dict>
</dict>
</plist>
